<!--
UNIFIED TEMPLATE: Brand Contact Page
Purpose: Contact page content for brand pages
Usage: Include this template in brand contact pages
Variables: 
- brand_data (required): Brand data from _data
- page_title (required): Page title
- page_subtitle (required): Page subtitle
- page_description (required): Page description
-->

{% assign brand = brand_data %}

{% include "templates/page-header.liquid" %}

<!-- Contact Section -->
<section class="py-20 bg-white">
    <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
            <!-- Contact Introduction with Brand Logo -->
            <div class="text-center mb-16">
                <div class="flex justify-center mb-8">
                    <img src="/assets/images/{{ brand.slug }}.svg" alt="{{ brand.name }} Logo" class="h-20 w-auto">
                </div>
                <h3 class="text-2xl font-semibold mb-6 text-primefix-orange">Get Expert {{ brand.name }} Repair Service
                    Today</h3>
                <p class="text-lg text-gray-700 max-w-3xl mx-auto">
                    Don't let {{ brand.name }} appliance problems disrupt your routine. Our {{ brand.qualification |
                    downcase }} technicians are ready to provide fast, reliable repair service throughout Orange County.
                </p>
            </div>

            <!-- Contact Options -->
            <div class="grid md:grid-cols-2 gap-12 mb-16">
                <!-- Phone Contact -->
                <div class="bg-{{ brand.color_class | default: 'blue' }}-50 p-8 rounded-lg">
                    <h4 class="text-2xl font-semibold mb-4 text-gray-800">{{ brand.accent }} Call for Immediate Service
                    </h4>
                    <p class="text-lg text-gray-700 mb-6">
                        Speak directly with our {{ brand.name }} specialists. We're available Monday to Friday for
                        emergency repairs and same-day appointments.
                    </p>
                    <div class="mb-6">
                        <div class="text-3xl font-bold text-primefix-orange mb-2">{{ site.phone }}</div>
                        <p class="text-gray-600">{{ site.business_hours }}</p>
                    </div>
                    <a href="{{ site.phone_href }}"
                        class="bg-primefix-orange text-white px-8 py-3 rounded-lg hover:bg-orange-600 transition inline-block">
                        Call Now for {{ brand.name }} Service
                    </a>
                </div>

                <!-- Online Contact -->
                <div class="bg-gray-50 p-8 rounded-lg">
                    <h4 class="text-2xl font-semibold mb-4 text-gray-800">📅 Schedule Online</h4>
                    <p class="text-lg text-gray-700 mb-6">
                        Prefer to schedule online? Fill out our service request form and we'll contact you within 2
                        hours to confirm your {{ brand.name }} repair appointment.
                    </p>
                    <div class="mb-6">
                        <div class="text-lg font-semibold text-gray-800 mb-2">Quick Response Time</div>
                        <p class="text-gray-600">We respond to all service requests within 2 hours during business
                            hours.</p>
                    </div>
                    <a href="#contact-form"
                        class="bg-gray-800 text-white px-8 py-3 rounded-lg hover:bg-gray-700 transition inline-block">
                        Schedule {{ brand.name }} Service
                    </a>
                </div>
            </div>

            <!-- Service Information -->
            <div class="grid md:grid-cols-3 gap-8 mb-16">
                <div class="text-center">
                    <div
                        class="bg-{{ brand.color_class | default: 'blue' }}-100 p-4 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                        <span class="text-2xl">⚡</span>
                    </div>
                    <h4 class="text-lg font-semibold mb-2">Same-Day Service</h4>
                    <p class="text-gray-700">Emergency {{ brand.name }} repairs available with same-day appointments
                        throughout Orange County.</p>
                </div>
                <div class="text-center">
                    <div
                        class="bg-{{ brand.color_class | default: 'blue' }}-100 p-4 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                        <span class="text-2xl">🎓</span>
                    </div>
                    <h4 class="text-lg font-semibold mb-2">{{ brand.qualification }} Technicians</h4>
                    <p class="text-gray-700">Our technicians are {{ brand.qualification | downcase }} in {{ brand.name
                        }} appliance repair and stay current with latest models.</p>
                </div>
                <div class="text-center">
                    <div
                        class="bg-{{ brand.color_class | default: 'blue' }}-100 p-4 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                        <span class="text-2xl">🔧</span>
                    </div>
                    <h4 class="text-lg font-semibold mb-2">Genuine Parts</h4>
                    <p class="text-gray-700">We use only genuine {{ brand.name }} OEM parts for all repairs and
                        replacements.</p>
                </div>
            </div>

            <!-- Contact Form -->
            <div id="contact-form" class="bg-white border border-gray-200 rounded-lg p-8 mb-16">
                <h3 class="text-2xl font-semibold mb-6 text-gray-800">Schedule Your {{ brand.name }} Repair Service</h3>
                <form class="space-y-6" data-netlify="true" name="brand-service-form" method="POST" action="/success/">
                    <!-- Netlify form detection -->
                    <input type="hidden" name="form-name" value="brand-service-form" />
                    <!-- Hidden field to identify which brand form was submitted -->
                    <input type="hidden" name="brand" value="{{ brand.name }}">

                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="customer_name" class="block text-gray-700 font-semibold mb-2">Name *</label>
                            <input type="text" id="customer_name" name="customer_name" required
                                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primefix-orange">
                        </div>
                        <div>
                            <label for="phone" class="block text-gray-700 font-semibold mb-2">Phone Number *</label>
                            <input type="tel" id="phone" name="phone" required
                                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primefix-orange">
                        </div>
                    </div>
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="email" class="block text-gray-700 font-semibold mb-2">Email Address *</label>
                            <input type="email" id="email" name="email" required
                                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primefix-orange">
                        </div>
                        <div>
                            <label for="appliance_model" class="block text-gray-700 font-semibold mb-2">{{ brand.name }}
                                Model</label>
                            <select id="appliance_model" name="appliance_model"
                                class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primefix-orange">
                                <option value="">Select your {{ brand.name }} model</option>
                                {% if brand.name == "Sub-Zero" %}
                                <option value="refrigerator">Refrigerator</option>
                                <option value="wine-cooler">Wine Cooler</option>
                                <option value="freezer">Freezer</option>
                                <option value="ice-maker">Ice Maker</option>
                                <option value="other">Other</option>
                                {% elsif brand.name == "Wolf" %}
                                <option value="range">Range</option>
                                <option value="oven">Oven</option>
                                <option value="cooktop">Cooktop</option>
                                <option value="hood">Ventilation Hood</option>
                                <option value="other">Other</option>
                                {% elsif brand.name == "Cove" %}
                                <option value="dishwasher">Dishwasher</option>
                                <option value="other">Other</option>
                                {% endif %}
                            </select>
                        </div>
                    </div>
                    <div>
                        <label for="service_address" class="block text-gray-700 font-semibold mb-2">Service Address
                            *</label>
                        <input type="text" id="service_address" name="service_address" required
                            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primefix-orange"
                            placeholder="Street address, city, and zip code">
                    </div>
                    <div>
                        <label for="problem_description" class="block text-gray-700 font-semibold mb-2">Describe the
                            Problem</label>
                        <textarea rows="4" id="problem_description" name="problem_description"
                            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primefix-orange"
                            placeholder="Please describe what's wrong with your {{ brand.name }} appliance"></textarea>
                    </div>
                    <div>
                        <label for="preferred_time" class="block text-gray-700 font-semibold mb-2">Preferred Service
                            Time</label>
                        <select id="preferred_time" name="preferred_time"
                            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primefix-orange">
                            <option value="">Select preferred time</option>
                            <option value="morning">Morning (8 AM - 12 PM)</option>
                            <option value="afternoon">Afternoon (12 PM - 5 PM)</option>
                            <option value="evening">Evening (5 PM - 8 PM)</option>
                            <option value="emergency">Emergency Service</option>
                        </select>
                    </div>
                    <div>
                        <button type="submit"
                            class="bg-primefix-orange text-white px-8 py-3 rounded-lg hover:bg-orange-600 transition">
                            Schedule {{ brand.name }} Service
                        </button>
                    </div>
                </form>
            </div>

            <!-- Service Area -->
            <div class="text-center">
                <h3 class="text-2xl font-semibold mb-6 text-primefix-orange">{{ brand.name }} Service Throughout Orange
                    County</h3>
                <p class="text-lg text-gray-700 mb-8">
                    We provide professional {{ brand.name }} appliance repair services throughout Orange County,
                    including:
                </p>
                <div class="grid md:grid-cols-3 gap-6 mb-8">
                    {% for area in site.service_areas %}
                    <div class="bg-gray-50 p-4 rounded-lg">
                        <span class="text-gray-700">{{ area }}</span>
                    </div>
                    {% endfor %}
                </div>
                <p class="text-gray-600">
                    Don't see your city listed? Call us at {{ site.phone }} - we service the entire Orange County area.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
{% assign cta_style = "brand" %}
{% assign brand_data = brand %}
{% assign cta_title = "Ready to Fix Your " | append: brand.name | append: " Appliance?" %}
{% assign cta_description = "Professional " | append: brand.name | append: " repair service available Monday to Friday"
%}
{% include "templates/cta-section.liquid" %}